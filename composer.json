{
    "name": "uemanet/harpia",
    "description": "Sistema de gestão modular.",
    "keywords": ["php", "harpia", "laravel"],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/uemanet/eloquent-table",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/uemanet/eloquent-table.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "mpdf/mpdf": "^8.0",
        "ramsey/uuid": "^4.2",
        "maatwebsite/excel": "^3.1",
        "laravel/tinker": "^2.9",
        "uemanet/eloquent-table": "dev-laravel10",
        "laravel/helpers": "^1.6",
        "laravel/ui": "^4.6",
        "laravel/legacy-factories": "^1.3",
        "spatie/laravel-html": "^3.12",
        "diglactic/laravel-breadcrumbs": "^10.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "brianium/paratest": "^7.0",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.0",
        "laravel/boost": "^2.4",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4",
        "squizlabs/php_codesniffer": "^3.9",
        "symfony/console": "^7.0"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modulos\\": "modulos/",
            "Harpia\\" : "Harpia/",
            "Tests\\" : "tests/"
        },
        "files": [
            "Harpia/FlashToastrAlert/functions.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "chmod +x fixcode",
            "bash bin/setup.sh"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
