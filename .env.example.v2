APP_NAME=Harpia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MYSQL - Baseado no Docker Compose
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=harpia
DB_USERNAME=harpia
DB_PASSWORD=harpia
DB_ROOT_PASSWORD=toor

# PGSQL - Baseado no Docker Compose
PGSQL_HOST=pgsql
PGSQL_PORT=5432
PGSQL_DATABASE=harpia
PGSQL_USERNAME=harpia
PGSQL_PASSWORD=harpia

# REDIS - Baseado no Docker Compose
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=harpia_redis
REDIS_PORT=6379

# TO DO - Em prod SESSION_ENCRYPT=true e definir SESSION_DOMAIN
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# MEMCACHED_HOST=127.0.0.1

# PMA - Baseado no Docker Compose
PMA_PORT=8080
# Porta exposta pelo container web no host
APP_PORT=80

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_AVALIACAO_SENDER=true
MAIL_AGENDAMENTO_SENDER=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CONTROLID_LOGIN=
CONTROLID_PASSWORD=